{
  "name": "media-backlog",
  "version": "1.0.0",
  "private": true,
  "description": "A full stack MERN application to help you manage your backlog of movies, games, TV shows, or whatever!",
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "lint": "npm run lint --prefix client"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvinmahmud/media-backlog.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/alvinmahmud/media-backlog/issues"
  },
  "homepage": "https://github.com/alvinmahmud/media-backlog#readme",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
